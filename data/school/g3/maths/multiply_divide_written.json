{
	"id": "g3.maths.multiply_divide_written",
	"lesson": [
		{
			"text": "Quick memory: 4 × 3 = 12. So 4 × 3 tens is 12 tens: 4 × 30 = 120. And 4 × 3 hundreds is 1,200.",
			"picture": {
				"kind": "table",
				"rows": [
					[
						"fact",
						"answer"
					],
					[
						"4 × 3",
						"12"
					],
					[
						"4 × 30",
						"120"
					],
					[
						"4 × 300",
						"1,200"
					]
				]
			}
		},
		{
			"text": "Multiply by tens: work out the small fact, then make it tens. 6 × 40: 6 × 4 = 24, so 6 × 40 = 24 tens = 240."
		},
		{
			"text": "Short multiplication: 47 × 6. Ones: 7 × 6 = 42, write 2 and carry 4. Tens: 4 × 6 = 24, add the 4 you carried: 28. So 47 × 6 = 282.",
			"picture": {
				"kind": "column",
				"rows": [
					"47",
					"× 6",
					"282"
				],
				"lines": [
					1
				]
			}
		},
		{
			"text": "Splitting works for bigger numbers too: 245 × 4 = 200 × 4 + 40 × 4 + 5 × 4 = 800 + 160 + 20 = 980.",
			"picture": {
				"kind": "area_model",
				"cols": [
					"200",
					"40",
					"5"
				],
				"rows": [
					"4"
				],
				"cells": [
					[
						"800",
						"160",
						"20"
					]
				]
			}
		},
		{
			"text": "Short division: 84 ÷ 4. Share the tens: 8 tens ÷ 4 = 2 tens. Share the ones: 4 ÷ 4 = 1. So 84 ÷ 4 = 21.",
			"picture": {
				"kind": "blocks",
				"thousands": 0,
				"hundreds": 0,
				"tens": 8,
				"ones": 4
			}
		},
		{
			"text": "Exchange what cannot be shared: 72 ÷ 3. 7 tens ÷ 3 = 2 tens, with 1 ten left over. That ten is 10 ones, so 12 ones ÷ 3 = 4. So 72 ÷ 3 = 24.",
			"picture": {
				"kind": "blocks",
				"thousands": 0,
				"hundreds": 0,
				"tens": 7,
				"ones": 2
			}
		},
		{
			"text": "Remainders: 29 ÷ 4 = 7 remainder 1. 7 groups of 4 is 28, and 1 is left over. In a story, think: does the left-over part need one more group? Next, in grade 4: dividing bigger numbers.",
			"picture": {
				"kind": "groups",
				"groups": 4,
				"each": 7,
				"left": 1
			}
		}
	],
