{
	"id": "g4.maths.multiply",
	"lesson": [
		{
			"text": "Quick memory: in grade 3 you met times tables. What is 7 × 8? 56."
		},
		{
			"text": "Multiply by tens: 4 × 3 = 12, so 4 × 30 = 120 and 4 × 300 = 1,200. Multiply the digits, then add the zeros."
		},
		{
			"text": "Split a big number into its places: 4 × 236 = 4 × 200 + 4 × 30 + 4 × 6 = 800 + 120 + 24 = 944.",
			"picture": {
				"kind": "area_model",
				"cols": [
					"200",
					"30",
					"6"
				],
				"rows": [
					"4"
				],
				"cells": [
					[
						"800",
						"120",
						"24"
					]
				]
			}
		},
		{
			"text": "An area model shows the split. A rectangle 23 long and 6 wide splits into 20 × 6 = 120 and 3 × 6 = 18. Together: 138.",
			"picture": {
				"kind": "rect",
				"w": 8,
				"h": 3,
				"grid": false,
				"label_w": "23",
				"label_h": "6"
			}
		},
		{
			"text": "Two two-digit numbers: 23 × 14 = 23 × 10 + 23 × 4 = 230 + 92 = 322."
		},
		{
			"text": "Try it in the world: build a wall 23 blocks long and 14 blocks high. How many blocks? 23 × 14 = 322. Split it into 23 × 10 and 23 × 4 to check. Next: dividing with remainders."
		}
	],
