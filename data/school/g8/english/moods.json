{
	"id": "g8.english.moods",
	"lesson": [
		{
			"text": "Verbs have moods that show the speaker's attitude."
		},
		{
			"text": "Indicative states facts or asks questions: The bus is late. Interrogative asks: Is the bus late? Imperative gives commands: Wait here."
		},
		{
			"text": "Conditional shows what would happen: If it rained, we would stay in."
		},
		{
			"text": "Subjunctive shows wishes or unreal situations: I wish I were taller. If I were you, I'd rest."
		}
	],
	"exercises": [
		{
			"type": "choice",
			"level": 1,
			"prompt": "Which mood gives a command?",
			"answer": 0,
			"hint": "Wait here!",
			"choices": [
				"imperative",
				"indicative",
				"subjunctive"
			],
			"explain": "Imperative."
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "\"The bus is late.\" What mood is this?",
			"answer": 0,
			"hint": "It states a fact.",
			"choices": [
				"indicative",
				"imperative",
				"conditional"
			],
			"explain": "Indicative."
		},
		{
			"type": "truefalse",
			"level": 1,
			"prompt": "\"Is the bus late?\" is interrogative.",
			"answer": true,
			"hint": "A question.",
			"explain": "Yes."
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "Which sentence is imperative?",
			"answer": 0,
			"hint": "A command.",
			"choices": [
				"Close the door.",
				"The door is closed.",
				"Is the door closed?"
			],
			"explain": "\"Close the door.\""
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "Which mood shows what would happen?",
			"answer": 0,
			"hint": "If… would…",
			"choices": [
				"conditional",
				"imperative",
				"interrogative"
			],
			"explain": "Conditional."
		},
		{
			"type": "choice",
			"level": 2,
			"prompt": "Which is subjunctive?",
			"answer": 0,
			"hint": "A wish…",
			"choices": [
				"I wish I were taller.",
				"I am tall.",
				"Am I tall?"
			],
			"explain": "\"I wish I were\" is subjunctive."
		},
		{
			"type": "choice",
			"level": 2,
			"prompt": "Choose the subjunctive: \"If I ___ you, I'd rest.\"",
			"answer": 0,
			"hint": "Unreal situation.",
			"choices": [
				"were",
				"was",
				"am"
			],
			"explain": "\"If I were you\"."
		},
		{
			"type": "choice",
			"level": 2,
			"prompt": "\"If it snowed, we would build a fort.\" What mood is this?",
			"answer": 0,
			"hint": "would…",
			"choices": [
				"conditional",
				"imperative",
				"indicative"
			],
			"explain": "Conditional."
		},
		{
			"type": "truefalse",
			"level": 2,
			"prompt": "\"Please sit down\" is in the imperative mood.",
			"answer": true,
			"hint": "A polite command.",
			"explain": "Yes."
		},
		{
			"type": "choice",
			"level": 2,
			"prompt": "Which sentence is interrogative?",
			"answer": 0,
			"hint": "A question.",
			"choices": [
				"Where are my keys?",
				"My keys are lost.",
				"Find my keys."
			],
			"explain": "\"Where are my keys?\""
		},
		{
			"type": "choice",
			"level": 3,
			"prompt": "Why use the subjunctive in \"The coach insists that he be on time\"?",
			"answer": 0,
			"hint": "insists that…",
			"choices": [
