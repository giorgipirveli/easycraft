{
	"id": "g8.english.pauses_breaks",
	"lesson": [
		{
			"text": "Punctuation can show pauses and breaks in thought."
		},
		{
			"text": "An ellipsis (…) shows a trailing thought, a hesitation or missing words: \"I thought… maybe… we could try.\""
		},
		{
			"text": "A dash (—) shows a sudden break or an added thought: \"I opened the box — it was empty!\""
		},
		{
			"text": "Commas show a gentle pause: \"Well, I suppose so.\""
		}
	],
	"exercises": [
		{
			"type": "choice",
			"level": 1,
			"prompt": "What does an ellipsis (…) often show?",
			"answer": 0,
			"hint": "Three dots…",
			"choices": [
				"a trailing or hesitant thought",
				"a question",
				"a list"
			],
			"explain": "A hesitation or trailing off."
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "Which mark shows a sudden break?",
			"answer": 0,
			"hint": "—",
			"choices": [
				"a dash",
				"a full stop",
				"a comma"
			],
			"explain": "A dash."
		},
		{
			"type": "truefalse",
			"level": 1,
			"prompt": "A comma shows a gentle pause.",
			"answer": true,
			"hint": "Well, I suppose so.",
