{
	"id": "g8.english.verbals",
	"lesson": [
		{
			"text": "Verbals are formed from verbs but act as other parts of speech."
		},
		{
			"text": "A gerund is an -ing word used as a noun: Swimming is fun. I enjoy reading."
		},
		{
			"text": "A participle is a verb form used as an adjective: the crying baby, the broken window."
		},
		{
			"text": "An infinitive is \"to\" + a verb, used as a noun, adjective or adverb: To win was her goal. We went to the park to play."
		}
	],
	"exercises": [
		{
			"type": "choice",
			"level": 1,
			"prompt": "In \"Swimming is fun\", what is \"swimming\"?",
			"answer": 0,
			"hint": "It acts as a noun.",
			"choices": [
				"a gerund",
				"a participle",
				"an infinitive"
			],
			"explain": "It is the subject: a gerund."
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "Which is an infinitive?",
			"answer": 0,
			"hint": "to + verb.",
			"choices": [
				"to play",
				"playing",
				"played"
			],
			"explain": "\"To play\"."
		},
		{
			"type": "truefalse",
			"level": 1,
			"prompt": "In \"the broken window\", \"broken\" is a participle.",
			"answer": true,
			"hint": "It describes the window.",
			"explain": "Yes."
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "What does a participle act as?",
			"answer": 0,
			"hint": "the crying baby…",
			"choices": [
				"an adjective",
				"a noun",
				"a full stop"
			],
			"explain": "An adjective."
		},
		{
			"type": "choice",
			"level": 1,
			"prompt": "In \"I enjoy reading\", what is \"reading\"?",
			"answer": 0,
			"hint": "It is what I enjoy (a noun).",
			"choices": [
				"a gerund",
				"a participle",
				"an infinitive"
			],
			"explain": "A gerund."
		},
		{
			"type": "choice",
			"level": 2,
			"prompt": "In \"We came to help\", what does \"to help\" do?",
			"answer": 0,
			"hint": "Why did we come?",
			"choices": [
				"tells why we came",
				"names a person",
				"describes a noun"
			],
			"explain": "The infinitive tells the purpose."
		},
		{
			"type": "choice",
			"level": 2,
			"prompt": "Which sentence uses a participle?",
			"answer": 0,
			"hint": "Which one describes a noun?",
			"choices": [
				"The barking dog woke us.",
				"Barking is noisy.",
				"The dog likes to bark."
