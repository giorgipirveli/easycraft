			"type": "choice",
			"level": 2,
			"prompt": "Which sentence uses a gerund?",
			"answer": 0,
			"hint": "An -ing word as a noun.",
			"choices": [
				"Cycling keeps me fit.",
				"The cycling club met.",
				"I want to cycle."
			],
			"explain": "\"Cycling\" is the subject."
		},
