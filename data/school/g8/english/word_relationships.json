{
	"id": "g8.english.word_relationships",
	"lesson": [
		{
			"text": "Understanding how words relate helps you understand each one better."
		},
		{
			"text": "Relationships include synonyms, antonyms, part and whole, cause and effect, and degree: warm, hot, scorching."
		},
		{
			"text": "Words with similar denotations can have different connotations: a \"bargain\" and \"cheap\" both mean low-priced, but feel different."
		},
		{
			"text": "Analogies test relationships: glance is to stare as whisper is to shout (small to large)."
		}
	],
	"exercises": [
		{
			"type": "choice",
			"level": 1,
			"prompt": "Order of degree: which is hottest?",
			"answer": 0,
			"hint": "The strongest word.",
