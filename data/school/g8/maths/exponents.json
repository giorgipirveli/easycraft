{
	"id": "g8.maths.exponents",
	"lesson": [
		{
			"text": "Multiplying powers of the same number: add the exponents. 2³ × 2⁴ = 2⁷."
		},
		{
			"text": "Dividing: take away the exponents. 5⁶ ÷ 5² = 5⁴. A power of a power: multiply them. (3²)³ = 3⁶."
		},
		{
			"text": "Any number (except 0) to the power 0 is 1: 7⁰ = 1."
		},
		{
			"text": "A negative exponent means 1 over the power: 2 to the power of −3 is 1/2³ = 1/8."
		}
	],
	"exercises": [
