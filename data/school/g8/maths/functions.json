	"lesson": [
		{
			"text": "A function gives exactly one output for each input. Inputs 1, 2, 3 with outputs 5, 7, 9 is a function."
		},
		{
			"text": "If one input has two different outputs, like (2, 5) and (2, 8), it is not a function."
		},
		{
			"text": "A linear function makes a straight-line graph: its output changes by the same amount each step, like y = 3x + 1."
		},
		{
			"text": "Non-linear functions curve: y = x² goes 1, 4, 9, 16, rising by more each time."
		}
	],
