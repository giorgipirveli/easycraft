		},
		{
			"type": "number",
			"level": 2,
			"prompt": "Solve: 3(x + 1) = x + 11. What is x?",
			"answer": "4",
			"hint": "3x + 3 = x + 11.",
			"explain": "2x = 8, x = 4."
		},
		{
			"type": "choice",
