{
	"id": "g8.maths.linear_equations",
	"lesson": [
		{
			"text": "When x is on both sides, move the x terms to one side first: 5x + 3 = 2x + 12 gives 3x + 3 = 12, then 3x = 9, so x = 3."
		},
		{
			"text": "Some equations have one solution, some none, some infinitely many."
		},
		{
			"text": "No solution: the x terms cancel and a false statement is left: 2x + 1 = 2x + 5 gives 1 = 5."
		},
		{
			"text": "Infinitely many: both sides are the same: 3(x + 2) = 3x + 6 is true for every x."
		}
	],
	"exercises": [
		{
			"type": "number",
			"level": 1,
			"prompt": "Solve: 5x + 3 = 2x + 12. What is x?",
			"answer": "3",
			"hint": "Take 2x from both sides.",
			"explain": "3x = 9, x = 3."
		},
		{
			"type": "number",
			"level": 1,
			"prompt": "Solve: 4x − 2 = x + 7. What is x?",
			"answer": "3",
			"hint": "3x = 9.",
			"explain": "x = 3."
		},
		{
			"type": "truefalse",
			"level": 1,
			"prompt": "2x + 1 = 2x + 5 has no solution.",
			"answer": true,
			"hint": "The x terms cancel.",
