	"lesson": [
		{
			"text": "The square root of a number is what you multiply by itself to get it: √81 = 9, because 9 × 9 = 81."
		},
		{
			"text": "The cube root of a number is what you multiply by itself three times to get it: the cube root of 64 is 4."
		},
		{
			"text": "x² = 49 has two solutions, x = 7 and x = −7, because both square to 49."
		},
		{
			"text": "x³ = 27 has one real solution: x = 3."
		}
	],
