{
	"id": "g8.maths.scientific_notation",
	"lesson": [
		{
			"text": "Scientific notation writes a number as a number from 1 to 10 times a power of 10: 45,000 = 4.5 × 10⁴."
		},
		{
			"text": "Small numbers use negative powers: 0.0003 = 3 × 10 to the power of −4."
		},
		{
			"text": "To multiply, multiply the front numbers and add the exponents: (3 × 10⁴) × (2 × 10³) = 6 × 10⁷."
		},
		{
			"text": "It is handy for huge and tiny things: the Sun is about 1.5 × 10⁸ km away."
		}
	],
