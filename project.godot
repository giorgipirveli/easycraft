; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EasyCraft"
config/version="1.0.9"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.07450981, 0.61960787, 0.60784316, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/brand/splash.png"
config/icon="res://icon.png"

[audio]

general/text_to_speech=true

[autoload]

Updater="*res://autoloads/updater.gd"
AssetsPack="*res://autoloads/assets_pack.gd"
Profile="*res://autoloads/profile.gd"
Game="*res://autoloads/game.gd"
Session="*res://autoloads/session.gd"
Audio="*res://autoloads/audio.gd"
Music="*res://autoloads/music.gd"
Feel="*res://autoloads/feel.gd"
Progress="*res://autoloads/progress.gd"
Vr="*res://autoloads/vr.gd"
MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/easycraft_webview/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

