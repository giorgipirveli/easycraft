# EasyCraft server settings (docs/hosting.md). Make your own copy with:  ./kit.sh keys
# That writes .env with a new random value for every secret below. .env is never committed (it
# is in .gitignore) and never sent to anyone: it holds the keys to every child's account.
# Secrets use letters, digits and . _ ~ - only.

# --- Where the server lives -----------------------------------------------------------------
# The server's name on the internet: a domain (or free DuckDNS name) that points at this server's
# address (docs/hosting.md step 3). Caddy gets its HTTPS certificate for this name.
EASYCRAFT_DOMAIN=play.example.com

# --- Shipped inside the game (not a secret, but it must match) ------------------------------
# Nakama's socket.server_key. The game sends it with every sign-in; it must equal
# OnlineConfig.RELEASE_SERVER_KEY in core/net/online_config.gd (tests/unit/test_hosting_kit.gd
# checks this line). To change it, change both and ship a new game version.
NAKAMA_SERVER_KEY=easycraft-3d4365aad6885d9a2e4bcc05

# --- Secrets: ./kit.sh keys fills these in ---------------------------------------------------
# The database password. Set once: PostgreSQL keeps the one it was first started with, so a new
# value here later locks Nakama out (docs/hosting.md, "Trouble").
POSTGRES_PASSWORD=
# Nakama signs the game's sessions with these (changing them signs every player out once; the
# game signs in again by itself). They must differ.
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=
# The developer console (reports, accounts): http://127.0.0.1:7351 through the SSH tunnel.
NAKAMA_CONSOLE_USERNAME=owner
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=
# Protects server-to-server calls of the module's RPCs (?http_key=...); the game never uses it.
NAKAMA_RUNTIME_HTTP_KEY=

# --- The server module's settings (optional) -------------------------------------------------
# "KEY=value KEY2=value2" handed to the TypeScript module as ctx.env (e.g. a consent provider's
# settings, once the owner has registered with one). EASYCRAFT_ENV=production is always added.
EASYCRAFT_RUNTIME_ENV=

# --- Backups -----------------------------------------------------------------------------------
# One backup of the database every day at this time (UTC), kept in ./backups; the newest
# BACKUP_KEEP daily backups are kept, older ones are deleted.
BACKUP_AT=03:30
BACKUP_KEEP=7
