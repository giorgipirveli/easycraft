func _rows(q: Dictionary) -> Array[String]:
	var out: Array[String] = []
	var n: int = q.size
	for y in n:
		var line := ""
		for x in n:
			line += "1" if q.dark[y * n + x] == 1 else "0"
		out.append(line)
	return out


func _expected(rows: Array) -> Array[String]:
	var out: Array[String] = []
	for r: String in rows:
		out.append(r)
	return out


func test_hello_matches_the_reference_with_mask_3() -> void:
	var q := QrCode.encode("HELLO", 3)
	assert_eq(q.version, 1)
	assert_eq(q.size, 21)
	assert_eq(_rows(q), _expected(HELLO_M3))


func test_the_invite_link_matches_the_reference_mask_and_all() -> void:
	var q := QrCode.encode("https://178-104-20-64.sslip.io/play/?invite=BLUE-OTTER-42")
	assert_eq(q.version, 4, "a 55-byte link fits version 4 at level M")
	assert_eq(q.mask, 6, "the mask with the lowest penalty, as the reference picks it")
	assert_eq(_rows(q), _expected(LINK_AUTO))


func test_a_version_8_code_with_its_version_bits_matches_the_reference() -> void:
	var text := ""
	for i in 15:
		text += "EasyCraft "
	var q := QrCode.encode(text)
	assert_eq(q.version, 8)
	assert_eq(q.mask, 7)
	assert_eq(_rows(q), _expected(LONG_V8))


func test_every_invite_link_fits_and_too_long_or_empty_does_not() -> void:
	for code in ["BLUE-OTTER-42", "FAMILY-SILVER-PENGUIN-9999", "CLASS-STARRY-UNICORN-99"]:
		for link in [InviteRules.link(code), InviteRules.pages_link(code)]:
			var q := QrCode.encode(link)
			assert_false(q.is_empty(), link)
			assert_lte(int(q.version), 6, link)
	assert_eq(QrCode.encode(""), {})
	var long := ""
	for i in 300:
		long += "x"
	assert_eq(QrCode.encode(long), {}, "past version 10")
	assert_eq(QrCode.data_codewords(1), 16)
	assert_eq(QrCode.data_codewords(4), 64)
	assert_eq(QrCode.data_codewords(10), 216)
