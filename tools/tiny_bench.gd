extends SceneTree
## What the Tiny world's mouse villages cost (M3 Task 21c): placing a new 128 x 128 area's villages (once per area,
## then cached; the area's secrets are worked out first and not timed) in every universe that has them, and the
## generator's chunks around villages with and without them (the two generators alternate chunk by chunk, so a busy
## PC slows both alike). Writes nothing.
## Run: godot --headless --path . --script res://tools/tiny_bench.gd   (prints TINY_BENCH lines)

const SEED := 12345
const RINGS := 7


func _init() -> void:
	var shapes := {"meadows": MeadowsShape.new(SEED), "wild_meadows": MeadowsBiomeShape.new(SEED),
		"desert": DesertShape.new(SEED), "frost": FrostShape.new(SEED), "candy": CandyShape.new(SEED)}
	for n: String in shapes:
		var rules := SecretRules.new(SEED, shapes[n])
		var areas: Array[Vector2i] = []
		for az in range(-RINGS, RINGS + 1):
			for ax in range(-RINGS, RINGS + 1):
				areas.append(Vector2i(ax, az))
				rules.secrets_in_area(Vector2i(ax, az))
		var worst := 0.0
		var total := 0.0
		var found := 0
		for a in areas:
			var t0 := Time.get_ticks_usec()
			found += rules.tiny_in_area(a).size()
			var ms := (Time.get_ticks_usec() - t0) / 1000.0
			total += ms
			worst = maxf(worst, ms)
		print("TINY_BENCH areas universe=%s areas=%d villages=%d avg_ms=%.2f worst_ms=%.2f" % [n, areas.size(), found,
			total / areas.size(), worst])
	_chunks(MeadowsGenerator.new(), MeadowsGenerator.new(), "meadows")
	_chunks(MeadowsBiomeGenerator.new(), MeadowsBiomeGenerator.new(), "wild_meadows")
	quit()


## The chunks of a few villages, generated by `with` (villages) and `without` (the same world, no villages) in turn.
func _chunks(with: MeadowsGenerator, without: MeadowsGenerator, n: String) -> void:
	with.world_seed = SEED
	without.world_seed = SEED
	without._secrets.tiny = null
	var chunks: Array[Vector3i] = []
	for az in range(-RINGS, RINGS + 1):
		for ax in range(-RINGS, RINGS + 1):
			for s: Dictionary in with._secrets.tiny_in_area(Vector2i(ax, az)):
				var lo: Vector3i = s.lo
				var hi: Vector3i = s.hi
				for cz in range(floori(lo.z / 16.0), floori((hi.z - 1) / 16.0) + 1):
					for cy in range(floori(lo.y / 16.0), floori((hi.y - 1) / 16.0) + 1):
						for cx in range(floori(lo.x / 16.0), floori((hi.x - 1) / 16.0) + 1):
							if chunks.size() < 120 and not chunks.has(Vector3i(cx, cy, cz)):
								chunks.append(Vector3i(cx, cy, cz))
	var t_with := 0.0
	var t_without := 0.0
	for c in chunks:
		for k in 2:
			var gen := with if (k == 0) == (c.x % 2 == 0) else without
			var buf := VoxelBuffer.new()
			buf.create(16, 16, 16)
			var t0 := Time.get_ticks_usec()
			gen._generate_block(buf, c * 16, 0)
			var ms := (Time.get_ticks_usec() - t0) / 1000.0
			if gen == with:
				t_with += ms
			else:
				t_without += ms
	print("TINY_BENCH chunks universe=%s chunks=%d with_avg_ms=%.2f without_avg_ms=%.2f" % [n, chunks.size(),
		t_with / maxi(chunks.size(), 1), t_without / maxi(chunks.size(), 1)])
